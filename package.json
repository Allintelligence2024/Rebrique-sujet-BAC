{
  "name": "miftah-kanz",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "مفتاح الكنز — منهجية الإجابة في بكالوريا علوم الطبيعة والحياة",
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:hard": "node --test tests/hard-benchmark.test.mjs",
    "build": "npm run pwa:version && node build.mjs",
    "lint": "eslint js data tests scripts build.mjs server.mjs playwright.config.mjs",
    "format:check": "prettier --check \"{js,data,tests,scripts}/**/*.{js,mjs,json,md}\" \"*.{js,mjs,json}\" \".github/workflows/*.yml\"",
    "typecheck": "tsc -p tsconfig.services.json",
    "calibration": "node tests/hard-benchmark/calibration-report.mjs",
    "calibration:update": "node scripts/update-calibration-status.mjs",
    "calibration:check": "node scripts/update-calibration-status.mjs --check",
    "coverage:official": "node scripts/report-official-coverage.mjs",
    "p1:status": "node scripts/report-p1-status.mjs",
    "p1:check": "node scripts/report-p1-status.mjs --check-complete",
    "p2:status": "node scripts/report-p2-status.mjs",
    "p2:check": "node scripts/report-p2-status.mjs --check-complete",
    "p3:status": "node scripts/report-p3-status.mjs",
    "p3:check": "node scripts/report-p3-status.mjs --check-complete",
    "pwa:version": "node scripts/generate-pwa-version.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "test:e2e": "playwright test",
    "docs:update": "node scripts/update-doc-metrics.mjs",
    "docs:check": "node scripts/update-doc-metrics.mjs --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.1",
    "jsdom": "^24.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  }
}
