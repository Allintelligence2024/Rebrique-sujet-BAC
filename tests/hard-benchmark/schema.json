{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HardBenchmarkCase",
  "type": "object",
  "required": ["cases"],
  "properties": {
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "year", "sujet", "exercise", "pole", "category",
          "answer", "humanNote", "source", "collector", "annotator", "date"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^\\d{4}-S\\d+-E\\d+-[NSEW]-\\d{3}$"
          },
          "year": { "type": "string", "minLength": 4, "maxLength": 4 },
          "sujet": { "type": "integer", "minimum": 1 },
          "exercise": { "type": "integer", "minimum": 1 },
          "pole": { "type": "string", "enum": ["N", "S", "E", "W"] },
          "category": { "type": "string", "minLength": 1 },
          "answer": { "type": "string", "minLength": 5 },
          "humanNote": { "type": "string" },
          "source": { "type": "string", "minLength": 1 },
          "collector": { "type": "string", "minLength": 1 },
          "annotator": { "type": "string", "minLength": 1 },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
